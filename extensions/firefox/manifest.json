{
  "manifest_version": 3,
  "name": "RDM — Download quietly",
  "version": "0.2.0",
  "description": "Send a chosen file link to your local Rust Download Manager.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rdm@delllatitude7490",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["browsingActivity"] }
    }
  },
  "permissions": ["nativeMessaging", "menus", "activeTab"],
  "incognito": "not_allowed",
  "background": { "scripts": ["background.js"], "type": "module" },
  "action": {
    "default_title": "RDM — Download quietly",
    "default_popup": "popup.html",
    "default_icon": "icons/download.svg"
  },
  "icons": { "48": "icons/download.svg", "96": "icons/download.svg" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
